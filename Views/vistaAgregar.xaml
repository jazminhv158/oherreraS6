<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="oherreraS6.Views.vistaAgregar"
             Title="vistaAgregar">
    <VerticalStackLayout
        Padding="20"
        Spacing="20">
        <Label 
            Text="Agregar Estudiantes"
            FontSize="18"
            FontAttributes="Bold"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <Entry
            x:Name="txtNombre"
            Placeholder="Ingresa nombre">
            
        </Entry>
        <Entry
            x:Name="txtApellido"
            Placeholder="ingrese apellido"></Entry>
        <Entry
            x:Name="txtEdad"
            Placeholder="ingrese edad"></Entry>

        <Button
            x:Name="btnGuardar"
            Text="Guardar"
            Clicked="btnGuardar_Clicked">
            
        </Button>
    </VerticalStackLayout>
</ContentPage>